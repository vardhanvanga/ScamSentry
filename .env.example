# =====================================================================
# ScamSentry (STAR-Fraud Engine) - Environment Configuration
# =====================================================================

# Application Configuration
APP_NAME=ScamSentry
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=*

# Dataset Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
PROCESSED_GRAPH_FILENAME=elliptic_pyg_graph.pt

# Artifact Paths
ARTIFACTS_DIR=artifacts
SAVED_MODELS_DIR=artifacts/saved_models
LOGS_DIR=artifacts/logs

# Temporal & Policy Engine Parameters
TEMPORAL_TRAIN_CUTOFF=34
TEMPORAL_TOTAL_TIMESTEPS=49
FRAUD_RISK_THRESHOLD=0.75
AUTOMATIC_FREEZE_ENABLED=True
